<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/TXVTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/marginTop"
        android:text="@string/appTitle"
        android:textSize="@dimen/textSizeTitle"
        android:textStyle="bold" />

    <GridLayout
        android:id="@+id/GRLTablero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/TXVTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/marginTop"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="3">

        <Button
            android:id="@+id/BTN00"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:layout_margin="@dimen/buttonMargin"
            android:textSize="@dimen/buttonTextSize"
            />

        <Button
            android:id="@+id/BTN01"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:layout_margin="@dimen/buttonMargin"
            android:textSize="@dimen/buttonTextSize"
            />

        <Button
            android:id="@+id/BTN02"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:layout_margin="@dimen/buttonMargin"
            android:textSize="@dimen/buttonTextSize"
            />

        <Button
            android:id="@+id/BTN10"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:layout_margin="@dimen/buttonMargin"
            android:textSize="@dimen/buttonTextSize"
            />

        <Button
            android:id="@+id/BTN11"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:layout_margin="@dimen/buttonMargin"
            android:textSize="@dimen/buttonTextSize"
            />

        <Button
            android:id="@+id/BTN12"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:layout_margin="@dimen/buttonMargin"
            android:textSize="@dimen/buttonTextSize"
            />

        <Button
            android:id="@+id/BTN20"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:layout_margin="@dimen/buttonMargin"
            android:textSize="@dimen/buttonTextSize"
            />

        <Button
            android:id="@+id/BTN21"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:layout_margin="@dimen/buttonMargin"
            android:textSize="@dimen/buttonTextSize"
            />

        <Button
            android:id="@+id/BTN22"
            android:layout_width="@dimen/buttonWidth"
            android:layout_height="@dimen/buttonHeight"
            android:layout_margin="@dimen/buttonMargin"
            android:textSize="@dimen/buttonTextSize"
            />

    </GridLayout>

    <TextView
        android:id="@+id/TXVPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/GRLTablero"
        android:text="@string/playerO"
        android:textSize="@dimen/textSizeNormal"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/marginTop"
        android:textColor="@color/purple_700"
        />

    <Button
        android:id="@+id/BTNRestart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/TXVPlayer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/marginTop"
        android:text="@string/Restart"
        android:textSize="@dimen/textSizeNormal"
        android:visibility="visible" />

</RelativeLayout>